# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se sube al repositorio (ver .gitignore).

# URL pública del sitio (usada en metadata, sitemap y JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.zentroagencia.com

# Número de WhatsApp de la agencia en formato E.164 sin espacios (se usa para los enlaces wa.me)
NEXT_PUBLIC_WHATSAPP_NUMBER=+593980649531

# Correo de contacto público (footer, mailto, remitente visible del formulario)
NEXT_PUBLIC_CONTACT_EMAIL=zentroagenciamkt@gmail.com

# --- Formulario de contacto (server-side, nunca se exponen al cliente) ---
# API key de Resend (https://resend.com). Si no está configurada, el endpoint
# /api/contact responde con un error controlado y la web sugiere escribir por WhatsApp.
RESEND_API_KEY=
# Remitente verificado en Resend (dominio propio verificado en producción)
CONTACT_EMAIL_FROM=Zentro Web <onboarding@resend.dev>
# Bandeja donde llegan los mensajes del formulario
CONTACT_EMAIL_TO=zentroagenciamkt@gmail.com
